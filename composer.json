{
    "name": "adamhebby/php-discord-bot-template",
    "type": "project",
    "autoload": {
        "psr-4": {
            "DiscordBot\\": "src/",
            "DiscordBot\\Test\\": "tests"
        }
    },
    "config": {
        "platform": {
            "php": "8.2"
        }
    },
    "require": {
        "team-reflex/discord-php": "^7.3",
        "symfony/dotenv": "^7.1",
        "php": "^8.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^11.3",
        "phpunit/php-code-coverage": "^11.0"
    }
}
